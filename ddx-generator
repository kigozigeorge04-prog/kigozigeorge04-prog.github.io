                references: ['Bailey & Love\'s Short Practice of Surgery, 27th Ed.'],
                criteria: [
                    { check: p => hasPCCategory(p, ['abdo-pain']), weight: 3, matchText: 'Abdominal pain' },
                    { check: p => p.hpc.site && p.hpc.site.includes('right iliac'), weight: 2, matchText: 'RIF pain' },
                    { check: p => hasROS(p, ['fever']), weight: 2, matchText: 'Fever' },
                    { check: p => ageIn(p, 3, 15), weight: 3, matchText: 'Age 3–15' },
                    { check: p => hasPE(p, 'abdo', 'RIF tenderness'), weight: 2, matchText: 'RIF tenderness' },
                ]
            });

            // ---- RENAL COLIC ----
            conditions.push({
                id: 'renal_colic',
                name: 'Renal Colic (Ureteric Stone)',
                category: 'Urology',
                references: ['Campbell-Walsh Urology, 12th Ed., Ch. 20'],
                criteria: [
                    { check: p => hasPCCategory(p, ['loin-pain', 'haematuria']), weight: 3,
                        matchText: 'Loin pain or haematuria' },
                    { check: p => p.hpc.site && (p.hpc.site.includes('loin') || p.hpc.site.includes('flank') || p.hpc.site
                            .includes('renal')), weight: 3, matchText: 'Loin / flank pain' },
                    { check: p => p.hpc.radiation && (p.hpc.radiation.includes('groin') || p.hpc.radiation.includes(
                        'inguinal')), weight: 2, matchText: 'Radiation to groin' },
                    { check: p => p.hpc.character && p.hpc.character.includes('colicky'), weight: 2,
                        matchText: 'Colicky pain' },
                    { check: p => hasROS(p, ['haematuria']), weight: 2, matchText: 'Haematuria' },
                    { check: p => hasROS(p, ['nausea', 'vomiting']), weight: 1, matchText: 'Nausea / vomiting' },
                    { check: p => hasPE(p, 'gu', 'Renal angle tenderness'), weight: 3,
                        matchText: 'Renal angle tenderness' },
                    { check: p => ageIn(p, 30, 60), weight: 1, matchText: 'Age 30–60' },
                ]
            });

            // ---- PERIPHERAL ARTERIAL DISEASE ----
            conditions.push({
                id: 'pad',
                name: 'Peripheral Arterial Disease',
                category: 'Vascular',
                references: ['Schwartz\'s Principles of Surgery, 11th Ed., Ch. 22'],
                criteria: [
                    { check: p => hasPCCategory(p, ['claudication', 'leg-ulcer']), weight: 3,
                        matchText: 'Claudication or leg ulcer' },
                    { check: p => p.hpc.character && (p.hpc.character.includes('cramping') || p.hpc.character.includes(
                        'aching')), weight: 2, matchText: 'Cramping / aching pain' },
                    { check: p => p.hpc.time && p.hpc.time.includes('walking'), weight: 2, matchText: 'Pain on walking' },
                    { check: p => p.hpc.relieving && p.hpc.relieving.includes('rest'), weight: 2,
                        matchText: 'Relieved by rest' },
                    { check: p => hasROS(p, ['leg pain', 'cold leg', 'skin changes']), weight: 2,
                        matchText: 'Leg symptoms' },
                    { check: p => p.smoking === 'current' || p.smoking === 'former', weight: 2,
                        matchText: 'Smoking history' },
                    { check: p => hasChronic(p, ['diabetes', 'hypertension']), weight: 2,
                        matchText: 'Diabetes / hypertension' },
                    { check: p => p.age > 50, weight: 1, matchText: 'Age >50' },
                ]
            });

            return conditions;
        }

        // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        // 6. RENDER RESULTS
        // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        function renderResults(results) {
            const container = document.getElementById('ddxResultsContainer');
            const section = document.getElementById('resultsSection');

            if (!results || results.length === 0) {
                container.innerHTML = `
                    <div style="text-align:center; padding:2rem; color:var(--muted);">
                        <div style="font-size:3rem; margin-bottom:1rem;">🔍</div>
                        <p>No differentials generated. Please enter more clinical data.</p>
                        <p style="font-size:0.85rem; margin-top:0.5rem;">Try adding more symptoms, exam findings, or risk factors.</p>
                    </div>
                `;
                section.style.display = 'block';
                return;
            }

            section.style.display = 'block';
            let html = '';

            results.forEach((result, index) => {
                const confidenceClass = result.confidence >= 70 ? 'high-confidence' :
                    result.confidence >= 40 ? '' : 'low-confidence';
                const confidenceColor = result.confidence >= 70 ? 'var(--success)' :
                    result.confidence >= 40 ? '#f1c40f' : 'var(--danger)';

                const uniqueTexts = [...new Set(result.matchedTexts || [])];
                const evidenceHtml = uniqueTexts.length ? `
                    <ul style="margin:0.3rem 0 0 1rem; font-size:0.82rem; color:var(--muted);">
                        ${uniqueTexts.map(text => `<li>${text}</li>`).join('')}
                    </ul>
                ` : '';

                const refsHtml = result.references && result.references.length ? `
                    <div style="font-size:0.65rem; color:var(--muted); margin-top:0.3rem;">
                        📖 ${result.references.join('; ')}
                    </div>
                ` : '';

                html += `
                    <div class="dx-item generated ${confidenceClass}" style="border-left-color:${confidenceColor};">
                        <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:0.5rem; flex-wrap:wrap;">
                            <div style="flex:1; min-width:0;">
                                <div style="display:flex; align-items:center; gap:0.5rem; flex-wrap:wrap;">
                                    <span style="font-weight:700; font-size:1rem;">${index + 1}. ${result.name}</span>
                                    <span class="badge ${result.confidence >= 70 ? 'badge-success' : result.confidence >= 40 ? 'badge-warning' : 'badge-danger'}">
                                        ${result.confidence}%
                                    </span>
                                    <span class="badge badge-info">${result.category}</span>
                                </div>
                                ${evidenceHtml}
                                ${refsHtml}
                            </div>
                        </div>
                        <div class="confidence-bar">
                            <div class="confidence-bar-fill" style="width:${result.confidence}%; background:${confidenceColor};"></div>
                        </div>
                    </div>
                `;
            });

            // Add summary stats
            html = `
                <div style="margin-bottom:1rem; padding:0.8rem 1rem; background:var(--primary-light); border-radius:8px; display:flex; gap:1rem; flex-wrap:wrap; justify-content:space-between;">
                    <div><strong>📊 Total Diagnoses:</strong> ${results.length}</div>
                    <div><strong>🎯 High Confidence (≥70%):</strong> ${results.filter(r => r.confidence >= 70).length}</div>
                    <div><strong>⚠️ Moderate (40-69%):</strong> ${results.filter(r => r.confidence >= 40 && r.confidence < 70).length}</div>
                    <div><strong>🔴 Low (&lt;40%):</strong> ${results.filter(r => r.confidence < 40).length}</div>
                </div>
                ${html}
            `;

            container.innerHTML = html;
            showToast(`✅ Generated ${results.length} differentials`, '#2a9d8f');
        }

        // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        // 7. INIT
        // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
        document.addEventListener('DOMContentLoaded', function() {
            // Check if there's a query parameter to auto-load
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.get('auto') === 'true') {
                loadFromLocalStorage();
            }
        });
    </script>

</body>
</html>
