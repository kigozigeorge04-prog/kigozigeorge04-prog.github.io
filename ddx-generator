        function generateDDXFromManual() {
            const patient = collectPatientData();
            const conditions = buildSurgeryKnowledgeBase();

            const results = conditions.map(cond => {
                let totalWeight = 0;
                let score = 0;
                const matchedTexts = [];
                cond.criteria.forEach(criterion => {
                    totalWeight += criterion.weight;
                    if (criterion.check(patient)) {
                        score += criterion.weight;
                        matchedTexts.push(criterion.matchText);
                    }
                });
                if (totalWeight === 0) return null;
                const confidence = Math.round((score / totalWeight) * 100);
                return {
                    ...cond,
                    score,
                    totalWeight,
                    confidence: Math.min(confidence, 100),
                    matchedTexts
                };
            }).filter(r => r !== null);

            results.sort((a, b) => b.confidence - a.confidence || b.score - a.score);
            renderResults(results);
        }

